# Cross-compile VoyagerCalc for Windows x64 from Linux: llvm-mingw (clang, UCRT, libc++) + Qt 6 built for llvm-mingw.
# Set these environment variables (or -D cache variables) before configuring:
#   LLVM_MINGW   llvm-mingw root (contains bin/x86_64-w64-mingw32-clang)
#   QT_WIN       Qt 6 for Windows x64 / llvm-mingw (e.g. .../6.8.3/llvm-mingw_64, from aqtinstall "win64_llvm_mingw")
#   QT_HOST_PATH Qt 6 for the Linux host, same version (moc, rcc and uic run there)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
foreach(v LLVM_MINGW QT_WIN QT_HOST_PATH)
  if(NOT DEFINED ${v} AND DEFINED ENV{${v}})
    set(${v} "$ENV{${v}}")
  endif()
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "set ${v} (environment variable or -D${v}=...)")
  endif()
endforeach()
set(CMAKE_C_COMPILER   ${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang)
set(CMAKE_CXX_COMPILER ${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++)
set(CMAKE_RC_COMPILER  ${LLVM_MINGW}/bin/x86_64-w64-mingw32-windres)
set(CMAKE_FIND_ROOT_PATH ${LLVM_MINGW}/x86_64-w64-mingw32 ${QT_WIN})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_PREFIX_PATH ${QT_WIN})
